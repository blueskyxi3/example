{
  "manifest": {
    "id": "example",
    "name": "插件示例",
    "version": "1.0.2",
    "sdk_version": 2,
    "extensions": [
      "site.navigation",
      "relay.request.intercept",
      "relay.response.intercept"
    ],
    "entry": "/assets/plugin.js"
  },
  "description": "请求拒绝与替换、原始渠道 JSON/SSE 文本脱敏、执行记录页面。完整演示使用 master＋slave 连接同一个 external 服务。",
  "logo": "/plugin-logos/example.svg",
  "modes": [
    "process",
    "external"
  ],
  "packages": {
    "darwin-arm64": "../example/dist/example-1.0.2-darwin-arm64.zip",
    "linux-amd64": "../example/dist/example-1.0.2-linux-amd64.zip",
    "linux-arm64": "../example/dist/example-1.0.2-linux-arm64.zip"
  },
  "trial_days": 7,
  "purchase_days": 0,
  "env_prefix": "EXAMPLE",
  "external_url": "",
  "secret_env": "EXAMPLE_HOST_SECRET",
  "rollback_compatible": false
}
